#!/usr/bin/env ruby.exe
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Install or update dependencies.
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # Create the local environment file when it doesn't exist.
  unless File.exist?(".env")
    unless File.exist?(".env.example")
      abort ".env.example is missing. Please create it first."
    end

    FileUtils.cp ".env.example", ".env"
    abort "Created .env. Set DATABASE_PASSWORD in .env, then run bin/setup again."
  end

  # Start Docker services and wait until they are healthy.
  puts "\n== Starting Docker services =="
  system! "docker", "compose", "up", "-d", "--wait"

  # Prepare the database.
  puts "\n== Preparing database =="
  system! "ruby", "bin/rails", "db:prepare"
  system! "ruby", "bin/rails", "db:reset" if ARGV.include?("--reset")

  # Clear old logs and temporary files.
  puts "\n== Removing old logs and tempfiles =="
  system! "ruby", "bin/rails", "log:clear", "tmp:clear"

  # Start the development server unless explicitly skipped.
  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "ruby", "bin/rails", "server"
  end
end
